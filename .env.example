# Postgres connection string used by both the app and goose migrations.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sportloga?sslmode=disable

# Signing secret for access tokens. Any long random string for local
# dev; use a real generated secret (e.g. `openssl rand -hex 32`) in
# staging/prod.
JWT_SECRET=dev-secret-change-me

# Resend API key, from the Resend dashboard.
RESEND_API_KEY=re_xxxxxxxxx

# Must be on a domain verified in your Resend dashboard. For local
# testing before you've verified a domain, Resend's shared sandbox
# address works but can only deliver to your own account email:
# RESEND_FROM_ADDRESS=<onboarding@resend.dev>
RESEND_FROM_ADDRESS=<otp@yourdomain.com>